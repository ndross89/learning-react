# Copy this file to .env.local and replace the placeholders.
# .env.local sits at the project root (next to package.json), not in src/.
# Vite only exposes names that start with VITE_. Restart `npm run dev` after editing.
# Dashboard → Connect. Publishable key, not the secret key, not the database password.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
